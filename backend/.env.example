NODE_ENV=development
PORT=5000
JWT_SECRET=replace-with-a-long-random-string
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GEMINI_API_KEY=your-gemini-api-key
FRONTEND_URL=http://localhost:5173
# 32-byte base64 key, e.g. `openssl rand -base64 32`
ENCRYPTION_KEY=replace-with-a-base64-32-byte-key
# Supabase Storage bucket for email attachments (create it in the dashboard)
SUPABASE_ATTACHMENTS_BUCKET=attachments
